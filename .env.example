# =============================================================================
# Frontend environment notes (Angular does NOT load .env at runtime by default)
# Real values live in:
#   src/environments/environment.ts       → local / ng serve
#   src/environments/environment.prod.ts  → production build (fileReplacements)
# =============================================================================

# Public API base used by the SPA (must match backend CORS + HTTPS)
API_BASE_URL=https://YOUR-BACKEND-HOST/api/v1

# GitHub Pages site (project pages)
# https://maheshpcse.github.io/banking-system/
GH_PAGES_BASE_HREF=/banking-system/

# Optional Docker build
# docker build --build-arg BASE_HREF=/ -t banking-system-fe .
BASE_HREF=/
